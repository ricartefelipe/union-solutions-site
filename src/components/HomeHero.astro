---
import Arrow from './Arrow.astro';
import Meander from './Meander.astro';
import ProductShot from './ProductShot.astro';
import { heroSlugs, products } from '../data/products';

// Três telas reais das demonstrações, em camadas: atrás, na frente e ao lado. Só a da frente carrega com prioridade.
const places = ['back', 'front', 'side'];
const layers = heroSlugs.map((slug, index) => ({ slug, place: places[index] }));
const shots = layers.map(({ slug, place }) => {
  const product = products.find((item) => item.slug === slug)!;
  return { product, place, screen: product.screens[0] };
});
---

<section class="hero surface-dark">
  <Meander class="hero__line" turns={5} radius={110} height={320} gap={26} nodes={false} />
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">Produtos próprios e software sob medida</span>
      <h1>Software para operar, integrar e <span class="hero__accent">evoluir seu negócio.</span></h1>
      <p class="lede hero__lede">Produtos que você testa no navegador, com dados fictícios, e sistemas construídos para a sua operação.</p>
      <div class="btn-row">
        <a class="btn" href="#produtos">Conhecer os produtos<Arrow /></a>
        <a class="btn btn--ghost" href="/demonstracoes/">Testar uma demonstração</a>
      </div>
    </div>

    <div class="hero__art" role="group" aria-label="Telas das demonstrações">
      {shots.map(({ product, place, screen }) => (
        <figure class:list={['hero__layer', `hero__layer--${place}`]}>
          <ProductShot screen={screen} priority={place === 'front'} sizes={place === 'front' ? '(min-width: 62rem) 36vw, 88vw' : '(min-width: 62rem) 26vw, 60vw'} />
          <figcaption>{product.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(2.75rem, 1.5rem + 5vw, 6rem) clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  /* Brilho discreto atrás das telas, na cor da marca. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -20%;
    right: -15%;
    width: min(70rem, 120vw);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
    pointer-events: none;
  }

  .hero :global(.hero__line) {
    position: absolute;
    z-index: -1;
    bottom: -6rem;
    left: -8rem;
    width: 60rem;
    max-width: none;
    color: var(--on-dark);
    opacity: 0.14;
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  h1 {
    max-width: 14ch;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 44ch;
    margin-block: var(--space-5) var(--space-6);
    color: var(--on-dark-soft);
  }

  /* Telas em camadas: a de trás espia por cima, a lateral cruza a borda inferior. */
  .hero__art {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    padding-bottom: 12%;
  }

  .hero__layer {
    position: relative;
    margin: 0;
  }

  .hero__layer--back {
    z-index: 0;
    grid-area: 1 / 4 / 2 / 13;
  }

  .hero__layer--front {
    z-index: 1;
    grid-area: 1 / 1 / 2 / 11;
    margin-top: 16%;
  }

  .hero__layer--side {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: 46%;
  }

  .hero__layer :global(.shot) {
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.75);
  }

  figcaption {
    position: absolute;
    top: 0.3125rem;
    right: 0.625rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    color: var(--on-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__layer {
      animation: layer-in 0.9s var(--ease) both;
    }

    .hero__layer--back {
      animation-delay: 0.1s;
    }

    .hero__layer--side {
      animation-delay: 0.25s;
    }

    @keyframes layer-in {
      from {
        opacity: 0;
        transform: translateY(1.25rem);
      }
    }
  }
</style>
