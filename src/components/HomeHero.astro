---
import Arrow from './Arrow.astro';
import Meander from './Meander.astro';
import { heroProof, productContactUrl } from '../data/products';

// A prova vem do exemplo do ArchLens no catálogo: achado automático, evidência e etapa escrita pelo arquiteto.
const proof = heroProof();
const diagnosisUrl = productContactUrl('archlens', 'diagnostico');
---

<section class="hero surface-dark">
  <Meander class="hero__line" turns={5} radius={110} height={320} gap={26} nodes={false} />
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">Diagnóstico Java, integrações e sistemas sob medida</span>
      <h1>Modernização de sistemas Java e <span class="hero__accent">integrações críticas.</span></h1>
      <p class="lede hero__lede">A Union Solutions analisa aplicações Java no seu ambiente e desenvolve integrações e sistemas sob medida.</p>
      <div class="btn-row">
        <a class="btn" href={diagnosisUrl}>Solicitar diagnóstico Java<Arrow /></a>
        <a class="btn btn--ghost" href={proof.href}>Ver exemplo de diagnóstico</a>
      </div>
    </div>

    <aside class="proof" aria-labelledby="prova-titulo">
      <p class="proof__tag" id="prova-titulo">Exemplo com dados fictícios</p>
      <ol class="proof__steps">
        <li>
          <span class="proof__label">Achado</span>
          <strong>{proof.finding}</strong>
          <span class="proof__meta">Severidade {proof.severity.toLowerCase()}, levantado por regra automática</span>
        </li>
        <li>
          <span class="proof__label">Evidência</span>
          <strong>{proof.evidence}</strong>
          <span class="proof__meta">Analisado no ambiente do cliente, sem enviar o código-fonte</span>
        </li>
        <li>
          <span class="proof__label">Etapa do roteiro</span>
          <strong>{proof.step}</strong>
          <span class="proof__meta">{proof.phase}, escrita pelo arquiteto na revisão</span>
        </li>
      </ol>
      <a class="text-link proof__link" href={proof.href}>Ver o exemplo completo<Arrow /></a>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(2.75rem, 1.5rem + 5vw, 6rem) clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  /* Brilho discreto atrás da prova, na cor da marca. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -20%;
    right: -15%;
    width: min(70rem, 120vw);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
    pointer-events: none;
  }

  .hero :global(.hero__line) {
    position: absolute;
    z-index: -1;
    bottom: -6rem;
    left: -8rem;
    width: 60rem;
    max-width: none;
    color: var(--on-dark);
    opacity: 0.14;
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  h1 {
    max-width: 16ch;
    font-size: var(--text-h1-home);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 44ch;
    margin-block: var(--space-5) var(--space-6);
  }

  /* Prova em HTML: lê-se sem imagem, em qualquer tema, e não muda o layout ao carregar. */
  .proof {
    position: relative;
    padding: var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.06);
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.75);
  }

  .proof__tag {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .proof__steps {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: etapa;
  }

  .proof__steps li {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding-left: 2.5rem;
    counter-increment: etapa;
  }

  .proof__steps li::before {
    content: counter(etapa);
    position: absolute;
    top: 0.1rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--brand-deep);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .proof__label {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .proof__steps strong {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .proof__meta {
    color: var(--on-dark-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .proof__link {
    margin-top: var(--space-4);
    color: var(--on-dark);
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    }
  }
</style>
