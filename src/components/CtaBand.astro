---
import Arrow from './Arrow.astro';
import Meander from './Meander.astro';

interface Props {
  title: string;
  text: string;
  label: string;
  href: string;
  secondary?: { label: string; href: string };
}

const { title, text, label, href, secondary } = Astro.props;
---

<section class="cta surface-dark">
  <Meander class="cta__art" turns={6} radius={100} height={300} gap={26} nodes={false} />
  <div class="wrap cta__inner">
    <h2>{title}</h2>
    <p class="lede muted">{text}</p>
    <div class="btn-row">
      <a class="btn" href={href}>{label}<Arrow /></a>
      {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: var(--section);
  }

  .cta :global(.cta__art) {
    position: absolute;
    top: 50%;
    left: 66%;
    display: none;
    width: 64rem;
    max-width: none;
    overflow: visible;
    color: var(--on-dark);
    opacity: 0.32;
    transform: translateY(-50%);
  }

  @media (min-width: 75rem) {
    .cta :global(.cta__art) {
      display: block;
    }
  }

  .cta__inner {
    position: relative;
  }

  h2 {
    max-width: 22ch;
    font-size: var(--text-h1-page);
  }

  .lede {
    max-width: 52ch;
    margin-block: var(--space-4) var(--space-5);
  }
</style>
