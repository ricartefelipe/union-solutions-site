---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from './Arrow.astro';
import PageHero from './PageHero.astro';
import TechStack from './TechStack.astro';
import { engagementModels, proposalSteps, serviceContactUrl, services, type Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((item) => item.slug !== service.slug);
const contactUrl = serviceContactUrl(service.slug);
---

<BaseLayout title={service.name} description={service.metaDescription}>
  <PageHero
    title={service.h1}
    intro={service.intro}
    eyebrow={service.name}
    crumbs={[{ label: 'Serviços', href: '/servicos/' }, { label: service.name }]}
  >
    <a slot="actions" class="btn" href={contactUrl}>{service.ctaLabel}<Arrow /></a>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <h2>Quando contratar</h2>
      <ul class="situations">
        {service.situations.map((item) => <li class="reveal">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section surface-mist">
    <div class="wrap split">
      <div class="split__sticky">
        <h2>O que pode fazer parte do trabalho</h2>
        <p class="muted side-note">O escopo é definido a partir do seu contexto.</p>
      </div>
      <ul class="rows">
        {service.scope.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-deep">
    <div class="wrap split">
      <div class="split__sticky">
        <h2>Entregáveis que podem ser acordados</h2>
        <p class="muted side-note">Cada contrato define quais destes entregáveis fazem parte do trabalho.</p>
      </div>
      <ul class="rows">
        {service.deliverables.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split__sticky">
        <h2>Modalidades de contratação</h2>
        <p class="muted side-note">Prazos e valores dependem do escopo e são apresentados na proposta.</p>
      </div>
      <ul class="rows">
        {engagementModels.map((model) => (
          <li>
            <h3>{model.title}</h3>
            <p class="muted">{model.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="surface-mist">
    <TechStack />
  </div>

  <section class="section surface-dark proposal">
    <div class="wrap split">
      <div>
        <h2>Como iniciar uma proposta</h2>
        <a class="btn proposal__cta" href={contactUrl}>{service.ctaLabel}<Arrow /></a>
      </div>
      <ol class="proposal__steps">
        {proposalSteps.map((step, index) => (
          <li>
            <span class="proposal__number" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p class="muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <nav class="other-services" aria-label="Outras frentes">
    <div class="wrap other-services__inner">
      <h2>Outras frentes</h2>
      <ul>
        {others.map((item) => (
          <li><a class="text-link" href={`/servicos/${item.slug}/`}>{item.name}<Arrow /></a></li>
        ))}
        <li><a class="text-link" href="/produtos/">Produtos próprios<Arrow /></a></li>
      </ul>
    </div>
  </nav>
</BaseLayout>

<style>
  .situations li {
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .situations li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .side-note {
    max-width: 34ch;
    margin-top: var(--space-3);
  }

  .proposal__cta {
    margin-top: var(--space-5);
  }

  .proposal__steps {
    display: grid;
    gap: var(--space-5);
  }

  .proposal__steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .proposal__number {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--font-display);
  }

  .proposal__steps h3 {
    margin-bottom: var(--space-1);
    font-size: 1.125rem;
  }

  .other-services {
    padding-block: var(--space-6);
  }

  .other-services__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-7);
  }

  .other-services h2 {
    font-size: var(--text-lg);
  }

  .other-services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }
</style>
