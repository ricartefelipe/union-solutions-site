---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from './Arrow.astro';
import PageHero from './PageHero.astro';
import { serviceContactUrl, services, type Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((item) => item.slug !== service.slug);
const contactUrl = serviceContactUrl(service.slug);
---

<BaseLayout title={service.name} description={service.metaDescription}>
  <PageHero
    title={service.h1}
    intro={service.intro}
    eyebrow={service.name}
    crumbs={[{ label: 'Serviços', href: '/servicos/' }, { label: service.name }]}
  >
    <a slot="actions" class="btn" href={contactUrl}>{service.ctaLabel}<Arrow /></a>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <h2>Quando contratar</h2>
      <ul class="situations">
        {service.situations.map((item) => <li class="reveal">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section surface-mist">
    <div class="wrap split">
      <div class="split__sticky">
        <h2>O que pode fazer parte do trabalho</h2>
        <p class="muted side-note">O escopo é definido a partir do seu contexto.</p>
      </div>
      <ul class="rows">
        {service.scope.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split__sticky">
        <h2>Entregáveis que podem ser acordados</h2>
        <p class="muted side-note">Cada contrato define quais destes entregáveis fazem parte do trabalho.</p>
      </div>
      <ul class="rows">
        {service.deliverables.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {service.related && (
    <section class="section surface-mist" aria-labelledby="apoio">
      <div class="wrap">
        <div class="card related">
          <div>
            <span class="eyebrow">Produto próprio</span>
            <h2 id="apoio">{service.related.title}</h2>
            <p class="muted">{service.related.text}</p>
          </div>
          <a class="btn btn--ghost" href={service.related.href}>{service.related.label}<Arrow /></a>
        </div>
      </div>
    </section>
  )}

  <section class="section surface-dark proposal">
    <div class="wrap proposal__inner">
      <div>
        <h2>Como iniciar uma proposta</h2>
        <p class="lede muted proposal__text">
          Conte o contexto na página de contato. Modalidades de contratação e tecnologias estão em <a href="/servicos/#modalidades">Serviços</a>.
        </p>
      </div>
      <a class="btn" href={contactUrl}>{service.ctaLabel}<Arrow /></a>
    </div>
  </section>

  <nav class="other-services" aria-label="Outras frentes">
    <div class="wrap other-services__inner">
      <h2>Outras frentes</h2>
      <ul>
        {others.map((item) => (
          <li><a class="text-link" href={`/servicos/${item.slug}/`}>{item.name}<Arrow /></a></li>
        ))}
        <li><a class="text-link" href="/produtos/">Produtos próprios<Arrow /></a></li>
      </ul>
    </div>
  </nav>
</BaseLayout>

<style>
  .side-note {
    max-width: 34ch;
    margin-top: var(--space-3);
  }

  .related {
    display: grid;
    gap: var(--space-5) var(--space-7);
    align-items: center;
    padding: var(--space-6);
  }

  .related h2 {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
  }

  .related p {
    max-width: var(--measure);
    margin-top: var(--space-3);
  }

  @media (min-width: 62rem) {
    .related {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .proposal__inner {
    display: grid;
    gap: var(--space-5) var(--space-7);
    align-items: center;
  }

  .proposal__text {
    max-width: 52ch;
    margin-top: var(--space-3);
  }

  .proposal__text a {
    color: var(--on-dark);
    font-weight: 600;
  }

  @media (min-width: 62rem) {
    .proposal__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .other-services {
    padding-block: var(--space-6);
  }

  .other-services__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-7);
  }

  .other-services h2 {
    font-size: var(--text-lg);
  }

  .other-services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }
</style>
