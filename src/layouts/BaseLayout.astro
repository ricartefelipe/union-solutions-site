---
import '@fontsource-variable/outfit/index.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contact, editorial, founder, site } from '../config/site';

interface Props {
  /** Título da página, sem o nome da empresa. Omita na home. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: software para operar, integrar e evoluir seu negócio`;

// Tudo o que exige URL absoluta só é publicado com domínio configurado.
const origin = Astro.site;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : null;
const socialImage = origin ? new URL(site.socialImage, origin).href : null;
const structuredData = origin
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.name,
      url: origin.href,
      logo: new URL('/icon-512.png', origin).href,
      description: site.summary,
      founder: { '@type': 'Person', name: founder.name, sameAs: editorial.url },
      ...(contact.email ? { email: contact.email } : {}),
      ...(contact.phone ? { telephone: contact.phone } : {}),
    }
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content={`Logo da ${site.name}`} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}

    {/* Marca a presença de JavaScript para o menu móvel: sem ele, a navegação fica sempre visível. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
