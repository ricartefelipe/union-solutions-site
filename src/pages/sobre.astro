---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FounderBlock from '../components/FounderBlock.astro';
import PageHero from '../components/PageHero.astro';

const principles = [
  {
    title: 'A decisão técnica responde a uma necessidade do negócio',
    text: 'A tecnologia é escolhida em função do problema, da operação e dos objetivos da empresa.',
  },
  {
    title: 'O caminho adequado pode não ser o maior',
    text: 'Um produto existente, uma consultoria ou uma solução sob medida atendem a situações diferentes. A avaliação começa por essa pergunta.',
  },
  {
    title: 'O escopo é combinado de forma explícita',
    text: 'O que será feito, o que será entregue e o que fica de fora são definidos na proposta.',
  },
  {
    title: 'O sistema precisa continuar funcionando depois da entrega',
    text: 'Segurança, desempenho e operação são considerados desde o desenho da solução.',
  },
];
---

<BaseLayout
  title="Sobre"
  description="A Union Solutions é uma empresa de tecnologia com produtos próprios, consultoria, arquitetura de software e desenvolvimento sob medida, fundada por Felipe Ricarte Magalhães."
>
  <PageHero
    title="Uma empresa de tecnologia que conecta decisão e construção."
    intro="Ajudamos empresas a operar, integrar e evoluir por meio de software: com um produto existente, com orientação técnica ou com um sistema construído para a sua realidade."
  />

  <section class="section" aria-labelledby="principios">
    <div class="wrap">
      <div class="section-head">
        <h2 id="principios">Como pensamos o trabalho</h2>
      </div>
      <ol class="principles">
        {principles.map((item, index) => (
          <li class="card reveal">
            <span class="principles__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section surface-mist">
    <div class="wrap">
      <FounderBlock />
    </div>
  </section>

  <CtaBand
    title="Conte o que sua empresa precisa."
    text="A primeira conversa serve para entender o cenário e indicar o caminho adequado, seja ele qual for."
    label="Falar com a Union Solutions"
    href="/contato/"
  />
</BaseLayout>

<style>
  .principles {
    display: grid;
    gap: var(--space-4);
  }

  .principles li {
    padding: var(--space-5);
  }

  .principles__number {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--eyebrow-ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .principles h3 {
    margin-bottom: var(--space-2);
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
