---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import HomeHero from '../components/HomeHero.astro';
import Meander from '../components/Meander.astro';
import ProductShot from '../components/ProductShot.astro';
import { founder } from '../config/site';
import { allHaveDemo, heroSlugs, homeProducts, products, type Product } from '../data/products';
import { services } from '../data/services';

// Vitrine: os destaques editoriais primeiro, depois os demais na ordem do catálogo. O maior espaço da grade fica com o
// destaque que tem mais telas na demonstração (sort estável: empate mantém a ordem do catálogo).
const featured = [...homeProducts].sort((a, b) => b.screens.length - a.screens.length);
const showcase = [...featured, ...products.filter((product) => !homeProducts.includes(product))];
// Produto que já aparece no topo da página mostra aqui outra tela, quando houver.
const screenFor = (product: Product) => (heroSlugs.includes(product.slug) && product.screens[1]) || product.screens[0];
const kind = (index: number) => (index === 0 ? 'lead' : index < homeProducts.length ? 'feature' : 'compact');
const sizes = {
  lead: '(min-width: 62rem) 54vw, 92vw',
  feature: '(min-width: 62rem) 26vw, (min-width: 40rem) 46vw, 92vw',
  compact: '(min-width: 62rem) 26vw, (min-width: 40rem) 46vw, 40vw',
};
---

<BaseLayout description="Produtos próprios com demonstração online, consultoria em tecnologia, arquitetura e desenvolvimento sob medida para empresas que precisam construir, integrar ou modernizar seus sistemas.">
  <HomeHero />

  <section class="section" id="produtos" aria-labelledby="produtos-titulo">
    <div class="wrap">
      <div class="section-head">
        <h2 id="produtos-titulo">
          {products.length} produtos próprios.{' '}
          <span class="title-soft">{allHaveDemo ? 'Todos com demonstração online.' : 'Vários com demonstração online.'}</span>
        </h2>
        <a class="text-link" href="/produtos/">Ver catálogo por necessidade<Arrow /></a>
      </div>

      <ul class="bento">
        {showcase.map((product, index) => (
          <li class:list={['card', 'card--link', 'tile', `tile--${kind(index)}`, 'reveal']}>
            <ProductShot screen={screenFor(product)} sizes={sizes[kind(index)]} />
            <div class="tile__body">
              <span class="eyebrow">{product.area}</span>
              <h3><a class="card__link" href={`/produtos/${product.slug}/`}>{product.name}</a></h3>
            </div>
            <Arrow />
          </li>
        ))}
        <li class="card card--link tile tile--more reveal">
          <Meander class="tile__art" turns={3} radius={60} height={150} gap={18} />
          <div class="tile__body">
            <span class="eyebrow">Demonstrações</span>
            <h3><a class="card__link" href="/demonstracoes/">Veja como entrar em cada uma</a></h3>
          </div>
          <Arrow />
        </li>
      </ul>
    </div>
  </section>

  <section class="section surface-mist" aria-labelledby="servicos-titulo">
    <div class="wrap">
      <div class="section-head">
        <h2 id="servicos-titulo">Quando o produto pronto não serve, <span class="title-soft">construímos sob medida.</span></h2>
        <a class="text-link" href="/servicos/">Ver os serviços<Arrow /></a>
      </div>
      <ul class="services">
        {services.map((service, index) => (
          <li class="card card--link service reveal">
            <span class="service__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3><a class="card__link" href={`/servicos/${service.slug}/`}>{service.name}</a></h3>
            <p class="muted">{service.summary}</p>
            <Arrow />
          </li>
        ))}
      </ul>
      <p class="founder-line muted">
        Fundada por {founder.name}, arquiteto de software. <a href="/sobre/">Conheça a Union Solutions</a>.
      </p>
    </div>
  </section>

  <CtaBand
    title="O que sua empresa precisa construir ou melhorar?"
    text="Conte seu cenário. Avaliamos se um produto existente, uma consultoria ou uma solução sob medida é o caminho adequado."
    label="Falar com a Union Solutions"
    href="/contato/"
  />
</BaseLayout>

<style>
  /* Vitrine em grade: o primeiro destaque ocupa duas colunas e duas linhas. */
  .bento {
    display: grid;
    gap: var(--space-4);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .tile__body {
    padding-inline: var(--space-2);
    padding-right: 2.5rem;
  }

  .tile .eyebrow {
    margin-bottom: var(--space-1);
  }

  .tile h3 {
    font-size: var(--text-xl);
  }

  .tile h3 a {
    text-decoration: none;
  }

  .tile > :global(.arrow) {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    width: 1.375rem;
    height: 1.375rem;
    color: var(--brand-ink);
  }

  .tile--more {
    justify-content: flex-end;
    overflow: hidden;
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }

  .tile--more :global(.tile__art) {
    width: 14rem;
    margin: var(--space-2) 0 0 var(--space-2);
    color: var(--brand-ink);
  }

  /* Móvel: os demais produtos em linhas compactas, com a tela pequena ao lado do nome. */
  @media (max-width: 39.99rem) {
    .tile--compact {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: var(--space-3);
    }

    .tile--compact :global(.shot__bar) {
      display: none;
    }

    .tile--compact .tile__body {
      padding: 0 2rem 0 0;
    }

    .tile--compact h3 {
      font-size: var(--text-lg);
    }

    .tile--compact > :global(.arrow) {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
  }

  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile--lead {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 62rem) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .tile--lead {
      grid-column: span 2;
      grid-row: span 2;
    }

    .tile--lead h3 {
      font-size: var(--text-h2);
    }

    /* A tela do destaque acompanha a altura das duas linhas e recorta o excesso à direita. */
    .tile--lead :global(.shot) {
      display: flex;
      flex: 1;
      flex-direction: column;
      min-height: 18rem;
    }

    .tile--lead :global(picture) {
      position: relative;
      flex: 1;
    }

    .tile--lead :global(img) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }
  }

  /* Serviços */
  .services {
    display: grid;
    gap: var(--space-4);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) 3.75rem;
  }

  .service__number {
    color: var(--eyebrow-ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .service h3 a {
    text-decoration: none;
  }

  .service > :global(.arrow) {
    position: absolute;
    bottom: var(--space-5);
    left: var(--space-5);
    width: 1.375rem;
    height: 1.375rem;
    color: var(--brand-ink);
  }

  @media (min-width: 62rem) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .founder-line {
    margin-top: var(--space-6);
  }

  .founder-line a {
    color: var(--brand-ink);
    font-weight: 600;
  }
</style>
