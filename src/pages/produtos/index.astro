---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import ProductShot from '../../components/ProductShot.astro';
import { allHaveDemo, productDemoUrl, products } from '../../data/products';
---

<BaseLayout
  title="Produtos"
  description="Conheça os produtos da Union Solutions para integrações, arquivos, assinaturas, ensino a distância, cartões e operações empresariais, com demonstração online."
>
  <PageHero
    title="Produtos para testar antes de decidir."
    intro={allHaveDemo
      ? 'Integrações, arquivos financeiros, assinaturas, operações comerciais e B2B, ensino a distância e cartões. Todos têm demonstração online, com dados fictícios.'
      : 'Integrações, arquivos financeiros, assinaturas, operações comerciais e B2B, ensino a distância e cartões. Os marcados com demonstração online podem ser testados no navegador.'}
  />

  <section class="section catalog-section" aria-label="Catálogo de produtos">
    <div class="wrap">
      <ul class="catalog">
        {products.map((product, index) => (
          <li class="card card--link product reveal" id={product.slug}>
            <ProductShot screen={product.screens[0]} sizes="(min-width: 62rem) 38vw, 92vw" priority={index < 2} />
            <div class="product__body">
              <span class="eyebrow">{product.area}</span>
              <h2><a class="card__link" href={`/produtos/${product.slug}/`}>{product.name}</a></h2>
              {!allHaveDemo && product.liveDemo && <p><span class="badge-demo">Demonstração online</span></p>}
              <p class="product__purpose">{product.purpose}</p>
              <ul class="node-list product__capabilities">
                {product.capabilities.slice(0, 3).map((capability) => <li>{capability}</li>)}
              </ul>
            </div>
            <div class="product__foot">
              <span class="product__more" aria-hidden="true">Conhecer o produto<Arrow /></span>
              {product.liveDemo && (
                <a class="text-link card__above" href={productDemoUrl(product.slug)}>Testar a demonstração<span class="sr-only"> do {product.name}</span></a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Nenhum produto atende ao seu caso?"
    text="Além dos produtos próprios, a Union Solutions oferece consultoria, arquitetura e desenvolvimento para necessidades específicas da sua empresa."
    label="Conhecer os serviços"
    href="/servicos/"
  />
</BaseLayout>

<style>
  .catalog-section {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .catalog {
    display: grid;
    gap: var(--space-5);
  }

  .product {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .product__body {
    padding: var(--space-5) var(--space-3) var(--space-3);
  }

  .product h2 {
    font-size: var(--text-h2);
  }

  .product h2 a {
    text-decoration: none;
  }

  .product__purpose {
    max-width: var(--measure);
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  .product__capabilities {
    gap: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .product__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: auto;
    padding: var(--space-3) var(--space-3) var(--space-1);
    border-top: 1px solid var(--card-line);
  }

  .product__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--brand-ink);
    font-weight: 600;
  }

  .product:hover .product__more :global(.arrow) {
    transform: translateX(0.25em);
  }

  @media (min-width: 62rem) {
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }
  }
</style>
