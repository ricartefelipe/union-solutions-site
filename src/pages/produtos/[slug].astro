---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import PageHero from '../../components/PageHero.astro';
import ProductGlyph from '../../components/ProductGlyph.astro';
import ProductShot from '../../components/ProductShot.astro';
import { productContactUrl, productDemoUrl, productSocialImage, products, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const contactUrl = productContactUrl(product.slug);
const [mainScreen, ...moreScreens] = product.screens;
const others = products.filter((item) => item.slug !== product.slug);
// Sem domínio configurado não há URL absoluta, e os dados estruturados ficam de fora, como no layout.
const origin = Astro.site?.href;
const pageUrl = origin ? new URL(`/produtos/${product.slug}/`, origin).href : undefined;
const structuredData = origin
  ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Produtos', item: new URL('/produtos/', origin).href },
      { '@type': 'ListItem', position: 2, name: product.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: product.name,
    description: product.purpose,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: pageUrl,
    image: new URL(productSocialImage(product).src, origin).href,
    ...(product.liveDemo ? { installUrl: product.liveDemo.url } : {}),
    provider: { '@type': 'Organization', name: 'Union Solutions', url: origin },
  },
]
  : [];
---

<BaseLayout title={product.seo.title} description={product.seo.description} image={productSocialImage(product)} structuredData={structuredData}>
  <PageHero
    title={product.name}
    intro={product.purpose}
    eyebrow={product.area}
    crumbs={[{ label: 'Produtos', href: '/produtos/' }, { label: product.name }]}
  >
    {product.liveDemo && <a slot="actions" class="btn" href={productDemoUrl(product.slug)}>Testar a demonstração<Arrow /></a>}
    <a slot="actions" class={product.liveDemo ? 'btn btn--ghost' : 'btn'} href={contactUrl}>{product.ctaLabel}</a>
    <Fragment slot="note">{product.availability}</Fragment>
    <div slot="art" class="product-art">
      <ProductShot screen={mainScreen} priority sizes="(min-width: 62rem) 46vw, 92vw" />
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Para quem</span>
        <h2>Em que situação o {product.name} ajuda</h2>
        <p class="lede muted audience">{product.context}</p>
      </div>
      <ul class="situations">
        {product.situations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section surface-mist" aria-labelledby="como-funciona">
    <div class="wrap">
      <div class="flow-head">
        <div>
          <span class="eyebrow">Como funciona</span>
          <h2 id="como-funciona">Do primeiro passo ao resultado</h2>
        </div>
        <div class="flow-head__art"><ProductGlyph slug={product.slug} /></div>
      </div>
      <ol class="flow">
        {product.flow.map((step, index) => (
          <li class="card">
            <span class="flow__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="split capabilities-row">
        <div>
          <h2 class="small-title">Capacidades</h2>
          <ul class="node-list capabilities">
            {product.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </div>
        <aside class="know" aria-labelledby="bom-saber">
          <h2 id="bom-saber" class="small-title">Bom saber</h2>
          <p>{product.goodToKnow}</p>
        </aside>
      </div>
    </div>
  </section>

  {product.sample && (
    <section class="section" id="exemplo" aria-labelledby="exemplo-titulo">
      <div class="wrap">
        <div class="section-head">
          <h2 id="exemplo-titulo">{product.sample.title} <span class="title-soft">com dados fictícios.</span></h2>
          {product.liveDemo && <a class="text-link" href={productDemoUrl(product.slug)}>Repetir na demonstração<Arrow /></a>}
        </div>
        <p class="lede muted sample-intro">{product.sample.intro}</p>
        {product.sample.cases.map((item) => (
          <article class="card sample">
            <div class="sample__head">
              <h3>{item.title}</h3>
              <p class="muted">{item.text}</p>
            </div>
            <div class="sample__io">
              <div class="sample__in">
                <span class="eyebrow">Entrada</span>
                <pre class="sample__code" tabindex="0"><code>{item.input.preview.join('\n')}</code></pre>
                <a class="text-link" href={item.input.href} download>Baixar {item.input.label}</a>
              </div>
              <div class="sample__out">
                <span class="eyebrow">Saída</span>
                {item.rows && (
                  <dl class="sample__rows">
                    {item.rows.map((row) => (
                      <div>
                        <dt>{row.label}</dt>
                        <dd>{row.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {item.events && <div class="sample__table" tabindex="0">
                  <table>
                    <caption class="sr-only">Eventos normalizados de {item.input.label}</caption>
                    <thead>
                      <tr><th scope="col">Data</th><th scope="col">Tipo</th><th scope="col">Valor</th><th scope="col">Descrição</th><th scope="col">Origem</th></tr>
                    </thead>
                    <tbody>
                      {item.events.map((event) => (
                        <tr>
                          <td>{event.date}</td>
                          <td>{event.direction}</td>
                          <td class="sample__amount">{event.amount}</td>
                          <td>{event.description}</td>
                          <td>{event.source}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>}
                <ul class="node-list sample__findings">
                  {item.findings.map((finding) => <li>{finding}</li>)}
                </ul>
                <a class="text-link" href={item.output.href} download>Baixar {item.output.label}</a>
              </div>
            </div>
          </article>
        ))}
        <p class="muted sample__provenance">{product.sample.provenance}</p>
      </div>
    </section>
  )}

  {moreScreens.length > 0 && (
    <section class="section" aria-labelledby="na-demonstracao">
      <div class="wrap">
        <div class="section-head">
          <h2 id="na-demonstracao">Na demonstração <span class="title-soft">com dados fictícios.</span></h2>
          {product.liveDemo && <a class="text-link" href={productDemoUrl(product.slug)}>Como entrar<Arrow /></a>}
        </div>
        {moreScreens.map((screen) => (
          <figure class="gallery">
            <ProductShot screen={screen} sizes="(min-width: 80rem) 76rem, 92vw" />
            <figcaption class="muted" aria-hidden="true">{screen.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section surface-deep" id="demonstracao" aria-labelledby="avaliar">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Como contratar</span>
        <h2 id="avaliar">Avaliar o {product.name} no seu cenário</h2>
        <p class="hiring">Sob proposta.</p>
        <p class="muted demo-text">
          A primeira conversa valida se o produto atende à sua operação e o que depende do seu ambiente, dos seus sistemas e de parceiros. Se não atender, dizemos quais outros caminhos fazem sentido. A proposta descreve objetivo, entregáveis, limites, prazos e valores.
        </p>
        <div class="btn-row">
          <a class="btn" href={contactUrl}>{product.ctaLabel}<Arrow /></a>
          {product.liveDemo && <a class="text-link" href={productDemoUrl(product.slug)}>Como entrar na demonstração</a>}
        </div>
      </div>
      <div>
        <h3 class="topics-title">O que vale levar para a conversa</h3>
        <ul class="node-list">
          {product.conversationTopics.map((topic) => <li>{topic}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <nav class="more-products" aria-label="Outros produtos">
    <div class="wrap">
      <h2>Outros produtos</h2>
      <ul>
        {others.map((item) => <li><a href={`/produtos/${item.slug}/`}>{item.name}</a></li>)}
        <li><a href="/servicos/">Serviços sob medida</a></li>
      </ul>
    </div>
  </nav>
</BaseLayout>

<style>
  .product-art :global(.shot) {
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.75);
  }

  .audience {
    margin-top: var(--space-3);
  }

  .flow-head {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    margin-bottom: var(--space-6);
  }

  .flow-head__art {
    width: 100%;
    max-width: 20rem;
    color: var(--brand-ink);
    --glyph-node-stroke: var(--brand-ink);
  }

  @media (min-width: 48rem) {
    .flow-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    }
  }

  .flow {
    display: grid;
    gap: var(--space-4);
  }

  .flow li {
    padding: var(--space-5);
  }

  .flow__number {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--eyebrow-ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .flow h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  @media (min-width: 48rem) {
    .flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .capabilities-row {
    margin-top: var(--space-7);
  }

  .small-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .know {
    align-self: start;
    padding: var(--space-5);
    border-left: 3px solid var(--notice-line);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: var(--notice-bg);
    color: var(--notice-ink);
  }

  .know .small-title {
    margin-bottom: var(--space-2);
  }

  .sample-intro {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }

  .sample {
    padding: var(--space-5);
  }

  .sample + .sample {
    margin-top: var(--space-5);
  }

  .sample__head h3 {
    font-size: var(--text-xl);
  }

  .sample__head p {
    max-width: var(--measure);
    margin-top: var(--space-2);
  }

  .sample__io {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  @media (min-width: 62rem) {
    .sample__io {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }

  /* Colunas da grade não podem crescer além da página por causa do trecho e da tabela. */
  .sample__in,
  .sample__out {
    min-width: 0;
  }

  .sample__in .eyebrow,
  .sample__out .eyebrow {
    display: block;
    margin-bottom: var(--space-3);
  }

  /* Trechos do arquivo e tabela rolam na horizontal em vez de quebrar a página. */
  .sample__code,
  .sample__table {
    overflow-x: auto;
    margin-bottom: var(--space-3);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-card);
    background: var(--mist);
  }

  .sample__code {
    padding: var(--space-4);
    font-family: ui-monospace, 'Cascadia Mono', 'Fira Mono', Menlo, Consolas, monospace;
    font-size: var(--text-sm);
    line-height: 1.6;
    white-space: pre;
  }

  .sample__rows {
    display: grid;
    gap: 0;
    margin-bottom: var(--space-3);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-card);
    background: var(--mist);
    font-size: var(--text-sm);
  }

  /* Em telas estreitas, rótulo em cima e valor embaixo; em telas largas, lado a lado. */
  .sample__rows > div {
    display: grid;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--card-line);
  }

  @media (min-width: 48rem) {
    .sample__rows > div {
      grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    }
  }

  .sample__rows > div:last-child {
    border-bottom: 0;
  }

  .sample__rows dt {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .sample__rows dd {
    overflow-wrap: anywhere;
  }

  .sample__table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .sample__table th,
  .sample__table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--card-line);
    text-align: left;
    white-space: nowrap;
  }

  .sample__table th {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .sample__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .sample__amount {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .sample__findings {
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .sample__provenance {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .gallery {
    margin: 0;
  }

  .gallery figcaption {
    max-width: var(--measure);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .hiring {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .demo-text {
    max-width: 48ch;
    margin-block: var(--space-2) var(--space-5);
  }

  .topics-title {
    margin-bottom: var(--space-4);
    font-size: 1.25rem;
  }

  .more-products {
    padding-block: var(--space-6);
  }

  .more-products h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .more-products ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .more-products a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--brand-ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--transition),
      background-color var(--transition);
  }

  .more-products a:hover {
    border-color: var(--card-line-hover);
    background: var(--mist);
  }
</style>
