---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import TechStack from '../../components/TechStack.astro';
import { engagementModels, services, workSteps, type ServiceSlug } from '../../data/services';

// Uma pergunta por caminho: cada serviço aparece aqui uma vez, com o link para a sua página.
const questions: Record<ServiceSlug, { question: string; answer: string }> = {
  consultoria: {
    question: 'O problema ainda não está claro?',
    answer: 'A consultoria investiga o que está acontecendo e indica o que fazer a seguir.',
  },
  arquitetura: {
    question: 'Há uma decisão de estrutura pela frente?',
    answer: 'A arquitetura define como a solução será organizada e como vai evoluir.',
  },
  desenvolvimento: {
    question: 'Já se sabe o que precisa ser construído?',
    answer: 'O desenvolvimento sob medida implementa a solução de acordo com seus processos.',
  },
};
const paths = [
  ...services.map((service) => ({ ...questions[service.slug], label: service.name, href: `/servicos/${service.slug}/` })),
  {
    question: 'A necessidade é específica e talvez já tenha solução?',
    answer: 'Vale conhecer os produtos próprios e avaliar a aderência à sua operação.',
    label: 'Produtos próprios',
    href: '/produtos/',
  },
];
---

<BaseLayout
  title="Serviços"
  description="Consultoria em tecnologia, arquitetura de software e desenvolvimento sob medida, da investigação do problema à implantação do sistema, conforme a necessidade da sua empresa."
>
  <PageHero
    title="Da decisão técnica ao sistema em uso."
    intro="Consultoria, arquitetura e desenvolvimento podem ser contratados separadamente ou em conjunto, conforme o momento da sua empresa."
  />

  <section class="section" aria-labelledby="comecar">
    <div class="wrap">
      <div class="section-head">
        <h2 id="comecar">Por onde começar <span class="title-soft">depende da pergunta que você tem hoje.</span></h2>
      </div>
      <ul class="paths">
        {paths.map((path) => (
          <li class="card card--link path reveal">
            <h3>{path.question}</h3>
            <p class="muted">{path.answer}</p>
            <a class="card__link text-link" href={path.href}>{path.label}<Arrow /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-mist" aria-labelledby="como-trabalhamos">
    <div class="wrap">
      <div class="section-head">
        <h2 id="como-trabalhamos">Como trabalhamos</h2>
      </div>
      <ol class="steps">
        {workSteps.map((step, index) => (
          <li>
            <span class="steps__number" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="modalidades" aria-labelledby="modalidades-titulo">
    <div class="wrap split">
      <div class="split__sticky">
        <h2 id="modalidades-titulo">Modalidades de contratação</h2>
        <p class="muted models-note">Prazos e valores dependem do escopo e são apresentados na proposta.</p>
      </div>
      <ul class="rows">
        {engagementModels.map((model) => (
          <li>
            <h3>{model.title}</h3>
            <p class="muted">{model.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="surface-mist">
    <TechStack />
  </div>

  <CtaBand
    title="Não sabe qual serviço é o adequado?"
    text="Não é preciso chegar com essa resposta. Conte seu cenário e avaliamos o caminho com você."
    label="Falar com a Union Solutions"
    href="/contato/"
  />
</BaseLayout>

<style>
  .paths {
    display: grid;
    gap: var(--space-4);
  }

  .path {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .path h3 {
    font-size: var(--text-xl);
  }

  .path .text-link {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .path:hover .text-link :global(.arrow) {
    transform: translateX(0.25em);
  }

  @media (min-width: 40rem) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .paths {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Etapas ligadas por uma linha, no sentido da evolução do trabalho. */
  .steps {
    display: grid;
    gap: var(--space-5);
  }

  .steps li {
    position: relative;
    padding-left: 3.25rem;
  }

  .steps__number {
    position: absolute;
    top: -0.125rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .steps h3 {
    margin-bottom: var(--space-1);
    font-size: 1.125rem;
  }

  @media (min-width: 62rem) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(1.25rem, 2vw, 2rem);
    }

    .steps li {
      padding-top: 3.25rem;
      padding-left: 0;
    }

    .steps li::before {
      content: '';
      position: absolute;
      top: 1.125rem;
      right: calc(clamp(1.25rem, 2vw, 2rem) * -1);
      left: 2.75rem;
      height: 1px;
      background: var(--line-strong);
    }

    .steps li:last-child::before {
      display: none;
    }
  }

  .models-note {
    max-width: 34ch;
    margin-top: var(--space-3);
  }
</style>
