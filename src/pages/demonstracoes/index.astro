---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import DemoAccess from '../../components/DemoAccess.astro';
import PageHero from '../../components/PageHero.astro';
import ProductShot from '../../components/ProductShot.astro';
import { demoProducts } from '../../data/products';
---

<BaseLayout
  title="Demonstrações online"
  description="Teste os produtos da Union Solutions no navegador, com acesso público e dados fictícios. Veja o que cada demonstração mostra e como entrar."
>
  <PageHero
    title="Teste os produtos no navegador."
    intro="Cada demonstração abaixo está no ar, com acesso público e dados de exemplo. Entre, explore e depois converse conosco sobre o seu cenário."
  />

  <section class="section notice-section" aria-labelledby="aviso">
    <div class="wrap">
      <div class="notice">
        <h2 id="aviso">Antes de entrar</h2>
        <ul class="node-list notice__list">
          <li>Os dados são fictícios. Não informe dados pessoais, de clientes ou de sua empresa.</li>
          <li>O ambiente é compartilhado: outras pessoas podem estar usando ao mesmo tempo.</li>
          <li>Tudo o que for criado é apagado diariamente, e a demonstração volta ao estado inicial.</li>
          <li>É uma amostra para avaliação. Não substitui a conversa sobre implantação, integrações e prazos.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section demos-section" aria-label="Demonstrações">
    <div class="wrap">
      <ul class="demos">
        {demoProducts.map((product) => (
          <li class="card demo reveal" id={product.slug}>
            <div class="demo__shot">
              <ProductShot screen={product.screens[0]} sizes="(min-width: 62rem) 30vw, 92vw" />
            </div>
            <div class="demo__body">
              <span class="eyebrow">{product.area}</span>
              <h2>{product.name}</h2>
              <p class="demo__note">{product.liveDemo!.note}</p>
              {product.liveDemo!.access && <DemoAccess access={product.liveDemo!.access} />}
              {product.liveDemo!.links && (
                <ul class="demo__links">
                  {product.liveDemo!.links.map((link) => <li><a href={link.url} rel="noopener">{link.label}<span class="sr-only"> do {product.name}</span></a></li>)}
                </ul>
              )}
              <div class="btn-row">
                <a class="btn" href={product.liveDemo!.url} rel="noopener">Abrir a demonstração<span class="sr-only"> do {product.name}</span><Arrow /></a>
                <a class="text-link" href={`/produtos/${product.slug}/`}>Sobre o produto<span class="sr-only"> {product.name}</span></a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Quer ver isso com os dados da sua operação?"
    text="Conte o seu cenário e mostramos como o produto se encaixa, com prazos e escopo claros."
    label="Conversar sobre meu projeto"
    href="/contato/"
  />
</BaseLayout>

<style>
  .notice-section {
    padding-bottom: 0;
  }

  .notice {
    display: grid;
    gap: var(--space-4) var(--space-7);
    padding: var(--space-5) var(--space-5);
    border-left: 3px solid var(--notice-line);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: var(--notice-bg);
    color: var(--notice-ink);
  }

  .notice h2 {
    font-size: var(--text-xl);
  }

  .notice__list {
    gap: var(--space-2);
  }

  @media (min-width: 62rem) {
    .notice {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    }

    .notice__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2) var(--space-6);
    }
  }

  .demos {
    display: grid;
    gap: var(--space-5);
  }

  .demo {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-3);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .demo__body {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }

  /* Em telas estreitas, cenário, acesso e ação vêm antes da imagem. */
  @media (max-width: 61.99rem) {
    .demo__body {
      order: -1;
    }
  }

  .demo h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-h2);
  }

  .demo__note {
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }

  .demo__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: calc(var(--space-2) * -1) 0 var(--space-3);
  }

  .demo__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--brand-ink);
    font-weight: 600;
  }

  @media (min-width: 62rem) {
    .demo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-6);
    }

    .demo__body {
      padding: var(--space-4) var(--space-4) var(--space-4) 0;
    }
  }
</style>
