# Configuração de produção do portal. Modelo versionado: nenhum segredo real.
#
#   sh portal-prod.sh segredos    cria .env com permissão 600, com os segredos internos já gerados
#   sh portal-prod.sh verificar   recusa valores que ainda digam SUBSTITUIR
#
# Guarde uma cópia de .env em local seguro fora da VPS: sem ela, a restauração não recupera o acesso aos serviços.
# Variáveis de ambiente de containers podem ser lidas por quem administra o Docker no servidor. Isto não é um cofre cifrado.

# ---------- Valores públicos ----------
PORTAL_HOST=clientes.unionsolutions.tech
PORTAL_PUBLIC_URL=https://clientes.unionsolutions.tech
# Conta usada pelo Caddy junto à autoridade certificadora (ACME).
PORTAL_ACME_EMAIL=contato@unionsolutions.tech
PORTAL_MAIL_FROM=contato@unionsolutions.tech

# ---------- A preencher: SMTP real, usado pela API (convites) e pelo provedor (definição e recuperação de senha) ----------
PORTAL_SMTP_HOST=SUBSTITUIR
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USER=SUBSTITUIR
PORTAL_SMTP_PASSWORD=SUBSTITUIR

# ---------- A preencher: primeiro administrador. Só tem efeito enquanto não houver administrador ----------
PORTAL_BOOTSTRAP_ADMIN_EMAIL=SUBSTITUIR

# ---------- A preencher: domínios aceitos em links de produtos, separados por vírgula. Pode ficar vazio ----------
PORTAL_PRODUCT_LINK_HOSTS=

# ---------- Retenção: desligada até a empresa aprovar uma política. Nenhum prazo abaixo é sugestão ----------
# Com PORTAL_RETENTION_ENABLED=false a API só simula (Retenção, no portal) e nunca remove nada.
# Para ligar: PORTAL_RETENTION_ENABLED=true e PORTAL_RETENTION_POLICY com a identificação do documento aprovado
# (por exemplo, "Política de retenção v1, aprovada em AAAA-MM-DD"). Prazos em dias; 0 = nunca remover.
PORTAL_RETENTION_ENABLED=false
PORTAL_RETENTION_POLICY=
PORTAL_RETENTION_NOTIFICATIONS_DAYS=0
PORTAL_RETENTION_EMAILS_DAYS=0
PORTAL_RETENTION_INVITATIONS_DAYS=0
PORTAL_RETENTION_CLOSED_TICKETS_DAYS=0
PORTAL_RETENTION_ARCHIVED_DOCUMENTS_DAYS=0
PORTAL_RETENTION_DISABLED_USERS_DAYS=0
PORTAL_RETENTION_AUDIT_DAYS=0

# ---------- A preencher: backup externo. Destino e retenção são decisões da empresa ----------
# Exemplos de formato do restic: sftp:usuario@servidor:/caminho ou s3:https://endpoint/bucket
RESTIC_REPOSITORY=SUBSTITUIR
# Guarde esta senha fora da VPS: sem ela, o backup não pode ser lido.
RESTIC_PASSWORD=GERADO
# Só para destino S3:
PORTAL_BACKUP_S3_ACCESS_KEY=
PORTAL_BACKUP_S3_SECRET_KEY=
PORTAL_BACKUP_KEEP_DAILY=SUBSTITUIR
PORTAL_BACKUP_KEEP_WEEKLY=SUBSTITUIR
PORTAL_BACKUP_KEEP_MONTHLY=SUBSTITUIR
PORTAL_BACKUP_MIN_FREE_MB=2048
# Prazo de cada etapa do envio, em segundos.
PORTAL_BACKUP_TIMEOUT_SECONDS=14400
# Idade máxima do último backup, em horas, antes de `backup-status` acusar falha.
PORTAL_BACKUP_MAX_AGE_HOURS=26

# ---------- Segredos internos: portal-prod.sh segredos gera, não precisa preencher ----------
POSTGRES_PASSWORD=GERADO
PORTAL_DB_PASSWORD=GERADO
KC_DB_PASSWORD=GERADO
PORTAL_SESSION_DB_PASSWORD=GERADO
KC_BOOTSTRAP_ADMIN_USERNAME=administracao-provedor
KC_BOOTSTRAP_ADMIN_PASSWORD=GERADO
PORTAL_WEB_CLIENT_SECRET=GERADO
PORTAL_KEYCLOAK_ADMIN_SECRET=GERADO
PORTAL_SESSION_SECRET=GERADO
PORTAL_S3_ACCESS_KEY=GERADO
PORTAL_S3_SECRET_KEY=GERADO
PORTAL_S3_OPS_ACCESS_KEY=GERADO
PORTAL_S3_OPS_SECRET_KEY=GERADO
