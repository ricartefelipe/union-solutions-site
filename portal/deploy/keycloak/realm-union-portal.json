{
  "realm": "union-portal",
  "displayName": "Portal do Cliente Union Solutions",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "sslRequired": "${PORTAL_KC_SSL_REQUIRED}",
  "bruteForceProtected": true,
  "failureFactor": 8,
  "permanentLockout": false,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR",
  "loginTheme": "union",
  "emailTheme": "keycloak",
  "smtpServer": {
    "host": "${PORTAL_SMTP_HOST}",
    "port": "${PORTAL_SMTP_PORT}",
    "from": "${PORTAL_MAIL_FROM}",
    "fromDisplayName": "Union Solutions",
    "auth": "${PORTAL_KC_SMTP_AUTH}",
    "user": "${PORTAL_SMTP_USER}",
    "password": "${PORTAL_SMTP_PASSWORD}",
    "starttls": "${PORTAL_KC_SMTP_STARTTLS}",
    "ssl": "false"
  },
  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "portal-web",
      "name": "Portal do Cliente",
      "enabled": true,
      "publicClient": false,
      "secret": "${PORTAL_WEB_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "${PORTAL_PUBLIC_URL}/auth/callback",
        "${PORTAL_PUBLIC_URL}/convite/continuar",
        "${PORTAL_PUBLIC_URL}/"
      ],
      "webOrigins": [],
      "rootUrl": "${PORTAL_PUBLIC_URL}",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PORTAL_PUBLIC_URL}/sessao-encerrada"
      },
      "defaultClientScopes": [
        "basic",
        "email",
        "profile",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal-api",
      "name": "API do Portal",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "portal-admin",
      "name": "Administração de contas do Portal",
      "enabled": true,
      "publicClient": false,
      "secret": "${PORTAL_KEYCLOAK_ADMIN_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-portal-admin",
      "enabled": true,
      "serviceAccountClientId": "portal-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-realm",
          "view-users"
        ]
      }
    }
  ],
