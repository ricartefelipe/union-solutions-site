{
  "name": "union-solutions-site",
  "private": true,
  "type": "module",
  "version": "1.3.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "check:links": "node scripts/check-links.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "verify": "npm run check && npm run build && npm run check:links",
    "check:contact": "node scripts/check-contact-states.mjs",
    "assets:brand": "python3 scripts/prepare-brand-assets.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
