# Instale em /etc/systemd/system. Reinicia os dados da demonstração do order-service uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do order-service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/orders
ExecStart=/bin/sh demo.sh reiniciar-dados
