# Demonstração do FileNorm. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-filenorm.unionsolutions.tech
FILENORM_TAG=v0.2.2
FILENORM_SRC=./src
FILENORM_DB_PASSWORD=GERADO
# Link de acesso ao painel vai por e-mail: a mesma conta SMTP do portal.
DEMO_SMTP_HOST=smtp.hostinger.com
DEMO_SMTP_PORT=587
DEMO_SMTP_USER=contato@unionsolutions.tech
DEMO_SMTP_PASSWORD=SUBSTITUIR
DEMO_MAIL_FROM=contato@unionsolutions.tech
# Limites da demonstração pública.
FILENORM_MAX_RECORDS=5000
FILENORM_MAX_PDF_PAGES=10
PORTAL_DEMOS_NETWORK=union-portal-prod_demos
