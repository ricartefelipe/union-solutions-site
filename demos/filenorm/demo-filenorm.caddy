# Instalado em portal/deploy/production/sites/ por demo.sh instalar. Só as rotas públicas do produto.
demo-filenorm.unionsolutions.tech {
	encode gzip
	request_body {
		max_size 3MB
	}
	header {
		>Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ?[removido]
			}
		}
	}
	handle /v1/* {
		reverse_proxy filenorm-api:8080
	}
	handle /actuator/health/liveness {
		reverse_proxy filenorm-api:8080
	}
	handle /actuator/* {
		respond 404
	}
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy filenorm-web:3000
	}
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "A demonstração está temporariamente indisponível. Tente novamente em instantes." {err.status_code}
	}
}
