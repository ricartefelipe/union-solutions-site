# Demonstração do ArchLens. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-archlens.unionsolutions.tech
ARCHLENS_SRC=./src
# Versão do produto: tag de release (ou commit validado). `ARCHLENS_COMMIT`, de .env antigos, ainda é aceito.
ARCHLENS_REF=v1.0.0
ARCHLENS_DB_PASSWORD=GERADO
ARCHLENS_AUTH_SECRET=GERADO
# Segredo entre o servidor do frontend e a API: sem ele, a API recusa a identidade (401). Nunca vai ao navegador.
ARCHLENS_LOCAL_HEADER_AUTH_SECRET=GERADO
# Só a conta "architect" é pública: a senha abaixo aparece na página do produto e dá acesso apenas a dados fictícios.
# As demais ficam com senhas geradas, usadas só pela operação.
ARCHLENS_DEMO_ARCHITECT_PASSWORD=union-demo
ARCHLENS_DEMO_ADMIN_PASSWORD=GERADO
ARCHLENS_DEMO_VIEWER_PASSWORD=GERADO
DEMOS_NETWORK=union-demos
