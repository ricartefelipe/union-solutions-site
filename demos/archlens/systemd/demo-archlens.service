# Instale em /etc/systemd/system. Reinicia os dados da demonstração do ArchLens uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do ArchLens
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/archlens
ExecStart=/bin/sh demo.sh reiniciar-dados
