# Demonstração do AssinaFlow. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-assinaflow.unionsolutions.tech
# Código do produto: pasta onde demo.sh instalar faz o checkout da tag abaixo.
ASSINAFLOW_TAG=v1.0.6
ASSINAFLOW_SRC=./src
ASSINAFLOW_DB_PASSWORD=GERADO
ASSINAFLOW_RABBIT_PASSWORD=GERADO
ASSINAFLOW_JWT_SECRET=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
