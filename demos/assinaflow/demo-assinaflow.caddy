# Instalado em demos/proxy/sites/ por demo.sh instalar. O frontend (nginx) já encaminha /api, /v3, /internal e
# /actuator para o backend internamente; aqui só liberamos o necessário ao público e bloqueamos o resto antes de chegar lá.
demo-assinaflow.unionsolutions.tech {
	encode gzip
	request_body {
		max_size 2MB
	}
	header {
		>Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ?[removido]
			}
		}
	}
	handle /actuator/health* {
		reverse_proxy assinaflow-web:8080
	}
	handle /actuator/* {
		respond 404
	}
	handle /internal/* {
		respond 404
	}
	handle /v3/* {
		respond 404
	}
	handle /swagger-ui* {
		respond 404
	}
	handle {
		reverse_proxy assinaflow-web:8080
	}
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "A demonstração está temporariamente indisponível. Tente novamente em instantes." {err.status_code}
	}
}
