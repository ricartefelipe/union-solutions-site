# Demonstração da API SpringMind. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-springmind.unionsolutions.tech
SPRINGMIND_SRC=./src
# A demonstração fica presa a versões validadas: tag no springmind, commit nos que não publicam tags.
SPRINGMIND_COMMIT=v0.1.1
REACTMIND_COMMIT=cc50b2874e3f0776cc539be3d15dcb0a618499e9
MIND_SHARED_COMMIT=3d39decfcfdb2c6afcd764d852f83f9a411eb511
SPRINGMIND_DB_PASSWORD=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
