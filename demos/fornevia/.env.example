# Demonstração do Fornevia. Crie o .env (permissão 600) com `sh demo.sh segredos`. Nenhum valor real é versionado.
# Endereço público. O DNS do hostname da VPS resolve qualquer subdomínio dele; para demo-fornevia.unionsolutions.tech,
# crie antes o registro A, troque aqui e rode `instalar`, a recarga do proxy e `subir`.
DEMO_HOST=demo-fornevia.unionsolutions.tech
# Tag das imagens demo-fornevia-app e demo-fornevia-web carregadas na VPS (versão do produto).
FORNEVIA_TAG=1.2.0
# Senha pública das 18 contas da carga de demonstração. O produto exige 12 caracteres ou mais.
FORNEVIA_DEMO_PASSWORD=fornevia-demo
APP_KEY=GERADO
DB_PASSWORD=GERADO
DB_OWNER_PASSWORD=GERADO
DB_RELAY_PASSWORD=GERADO
DB_SUPERUSER_PASSWORD=GERADO
REDIS_PASSWORD=GERADO
METRICS_TOKEN=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
