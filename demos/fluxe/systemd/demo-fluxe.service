# Instale em /etc/systemd/system. Reinicia os dados da demonstração da Fluxe B2B Suite uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração da Fluxe B2B Suite
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/fluxe
ExecStart=/bin/sh demo.sh reiniciar-dados
