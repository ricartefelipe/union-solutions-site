# Demonstração da Fluxe B2B Suite. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-fluxe.unionsolutions.tech
# Código do produto: quatro repositórios em subpastas de FLUXE_SRC, nas tags abaixo.
FLUXE_SRC=./src
FLUXE_TAG=v1.5.2
SAAS_CORE_TAG=v1.3.3
ORDERS_TAG=v1.4.3
PAYMENTS_TAG=v2.0.2
FLUXE_DB_PASSWORD=GERADO
FLUXE_REDIS_PASSWORD=GERADO
FLUXE_RABBIT_PASSWORD=GERADO
FLUXE_JWT_SECRET=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
