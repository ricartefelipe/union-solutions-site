# Demonstração do Pactor. Crie o .env (permissão 600) com `sh demo.sh segredos`. Nenhum valor real é versionado.
# Endereço público. O DNS do hostname da VPS resolve qualquer subdomínio dele; para demo-pactor.unionsolutions.tech,
# crie antes o registro A, troque aqui e rode `instalar`, a recarga do proxy e `subir`.
DEMO_HOST=demo-pactor.unionsolutions.tech
# Tag da imagem demo-pactor carregada na VPS (versão do produto).
PACTOR_TAG=0.3.2
PACTOR_SECRET_KEY=GERADO
PACTOR_SIMULATOR_WEBHOOK_SECRET=GERADO
PACTOR_ADMIN_PATH=GERADO
POSTGRES_SUPERUSER_PASSWORD=GERADO
PACTOR_OWNER_PASSWORD=GERADO
PACTOR_APP_PASSWORD=GERADO
PACTOR_BACKUP_PASSWORD=GERADO
RABBITMQ_PASSWORD=GERADO
REDIS_PASSWORD=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
