# Demonstração do Recorvia. Crie o .env (permissão 600) com `sh demo.sh segredos`. Nenhum valor real é versionado.
DEMO_HOST=demo-recorvia.unionsolutions.tech
# Tag do repositório público do produto, clonado em RECORVIA_SRC por `instalar`.
RECORVIA_TAG=v0.4.1
RECORVIA_SRC=./src
# Superusuário do PostgreSQL, usado só pelo bootstrap dos papéis.
RECORVIA_DB_PASSWORD=GERADO
# Senhas dos papéis recorvia_owner (migrations) e recorvia_app (aplicação).
RECORVIA_OWNER_PASSWORD=GERADO
RECORVIA_APP_PASSWORD=GERADO
RECORVIA_RABBIT_PASSWORD=GERADO
RECORVIA_REDIS_PASSWORD=GERADO
# Conta admin do realm master do Keycloak, usada só pelo ajuste do realm (demo.sh).
RECORVIA_KEYCLOAK_ADMIN_PASSWORD=GERADO
# Segredo do cliente recorvia-web, aplicado ao realm pelo ajuste do Keycloak.
RECORVIA_OIDC_CLIENT_SECRET=GERADO
# Chave de cifragem no formato id:base64 de 32 bytes, e o id dela como chave ativa.
RECORVIA_ENCRYPTION_KEYS=GERADO
RECORVIA_ENCRYPTION_ACTIVE_KEY=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
