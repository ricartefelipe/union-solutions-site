# Instale em /etc/systemd/system. Reinicia os dados da demonstração do Servora uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do Servora
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/servora
ExecStart=/bin/sh demo.sh reiniciar-dados
