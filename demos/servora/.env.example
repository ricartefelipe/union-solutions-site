# Demonstração do Servora. Crie o .env (permissão 600) com `sh demo.sh segredos`. Nenhum valor real é versionado.
# Endereço público. O DNS do hostname da VPS resolve qualquer subdomínio dele; para demo-servora.unionsolutions.tech,
# crie antes o registro A, troque aqui e rode `instalar`, a recarga do proxy e `subir`.
DEMO_HOST=demo-servora.unionsolutions.tech
# Tag da imagem demo-servora-app carregada na VPS (versão do produto).
SERVORA_TAG=1.6.0
# Senha pública das 10 contas da carga de demonstração (SEED_PASSWORD do produto). O produto exige 12 caracteres ou mais.
SERVORA_DEMO_PASSWORD=servora-demo-2026
SECRET_KEY_BASE=GERADO
AR_ENCRYPTION_PRIMARY_KEY=GERADO
AR_ENCRYPTION_DETERMINISTIC_KEY=GERADO
AR_ENCRYPTION_KEY_DERIVATION_SALT=GERADO
DB_SUPERUSER_PASSWORD=GERADO
DB_OWNER_PASSWORD=GERADO
DB_APP_PASSWORD=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
