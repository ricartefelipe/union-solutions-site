# Instale em /etc/systemd/system. Reinicia os dados da demonstração do Skillforge uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do Skillforge
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/skillforge
ExecStart=/bin/sh demo.sh reiniciar-dados
