# Demonstração do ComercialCloud. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-comercialcloud.unionsolutions.tech
COMERCIALCLOUD_TAG=v1.5.3
COMERCIALCLOUD_SRC=./src
COMERCIALCLOUD_DB_PASSWORD=GERADO
# Assinatura das sessões da demonstração (só no servidor, pelo menos 32 caracteres). Sem ela, o backend não sobe.
COMERCIALCLOUD_DEMO_SESSION_SECRET=GERADO
# Senha da conta de demonstração (admin@demo.com ou caixa@demo.com). Publicada de propósito, como nas demais demos.
COMERCIALCLOUD_DEMO_SENHA=union-demo
DEMOS_NETWORK=union-demos
