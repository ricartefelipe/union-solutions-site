{
	# Administração só por socket Unix dentro do container, sem porta TCP: é o que permite recarregar a configuração sem
	# derrubar as demonstrações (`recarregar.sh`). Só o próprio usuário do Caddy alcança o socket.
	admin unix//tmp/caddy-admin.sock|0600
	email {$ACME_EMAIL}
}

# Saúde do proxy: só dentro do container.
http://127.0.0.1:8081 {
	respond "ok" 200
}

# Cada demonstração instala aqui o seu site, com `demo.sh instalar`. Só o arquivo vazio é versionado.
import /etc/caddy/sites/*.caddy
