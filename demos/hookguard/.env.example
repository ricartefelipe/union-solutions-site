# Demonstração do HookGuard. Copie para .env (permissão 600) e preencha. Nenhum valor real é versionado.
DEMO_HOST=demo-hookguard.unionsolutions.tech
# Código do produto: pasta onde demo.sh instalar faz o checkout da tag abaixo.
HOOKGUARD_TAG=v1.0.5
HOOKGUARD_SRC=./src
HOOKGUARD_DB_PASSWORD=GERADO
# Link de acesso ao painel vai por e-mail: a mesma conta SMTP do portal.
DEMO_SMTP_HOST=smtp.hostinger.com
DEMO_SMTP_PORT=587
DEMO_SMTP_USER=contato@unionsolutions.tech
DEMO_SMTP_PASSWORD=SUBSTITUIR
DEMO_MAIL_FROM=contato@unionsolutions.tech
# Limites da demonstração pública.
HOOKGUARD_INGEST_RATE_LIMIT=60
HOOKGUARD_MAX_BODY_BYTES=262144
# Rede do proxy do portal que alcança a demonstração.
PORTAL_DEMOS_NETWORK=union-portal-prod_demos
