# Instale em /etc/systemd/system. Reinicia os dados da demonstração do HookGuard uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do HookGuard
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/hookguard
ExecStart=/bin/sh demo.sh reiniciar-dados
