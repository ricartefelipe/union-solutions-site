# Instale em /etc/systemd/system. Reinicia os dados da demonstração do cards-api uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do cards-api
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/cards
ExecStart=/bin/sh demo.sh reiniciar-dados
