# Demonstração do Locentra. Crie o .env (permissão 600) com `sh demo.sh segredos`. Nenhum valor real é versionado.
# Endereço público, com registro A para a VPS (DNS da Hostinger).
DEMO_HOST=demo-locentra.unionsolutions.tech
# Tag da imagem demo-locentra-app carregada na VPS (versão do produto).
LOCENTRA_TAG=1.5.0
# A senha das contas da carga é fixa no produto (lib/locentra/seed.rb): locentra-local-demo.
APP_SECRET_KEY_BASE=GERADO
APP_ENCRYPTION_KEY=GERADO
DB_SUPERUSER_PASSWORD=GERADO
LOCENTRA_OWNER_PASSWORD=GERADO
LOCENTRA_APP_PASSWORD=GERADO
LOCENTRA_WORKER_PASSWORD=GERADO
LOCENTRA_BACKUP_PASSWORD=GERADO
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
