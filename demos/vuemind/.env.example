# Demonstração da VueMind Wallet. Copie para .env (permissão 600). Nenhum valor real é versionado.
DEMO_HOST=demo-vuemind.unionsolutions.tech
VUEMIND_SRC=./src
# A demonstração fica presa às versões validadas (tags dos três repositórios).
VUEMIND_COMMIT=v0.1.0
VUEMIND_API_COMMIT=v0.3.0
MIND_SHARED_COMMIT=v2.1.0
# Rede do proxy das demonstrações.
DEMOS_NETWORK=union-demos
