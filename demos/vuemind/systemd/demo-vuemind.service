# Instale em /etc/systemd/system. Reinicia os dados da demonstração do VueMind Wallet uma vez por dia.
[Unit]
Description=Reinício diário dos dados da demonstração do VueMind Wallet
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/union-solutions/demos/vuemind
ExecStart=/bin/sh demo.sh reiniciar-dados
